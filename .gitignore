models/*
!models/.gitkeep
# SQLite 数据库（闹钟、对话记忆）、日志
data/
logs/
*.db
*.sqlite3

# ---- 本地配置 ----
# 本地覆盖配置可能含 API Key，不入库
config/config.local.yaml
.env

# ---- 系统 / 编辑器 ----
.DS_Store
.idea/
.vscode/
