# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# onnxruntime 预编译库（scripts/install_onnxruntime.sh 下载，体积较大且与平台相关）
.cache/

# ---- 运行时数据 ----
